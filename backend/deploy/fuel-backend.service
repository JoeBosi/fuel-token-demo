[Unit]
Description=FuelToken backend (API + daily price job)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and the two paths below to your installation.
User=fuel
WorkingDirectory=/opt/fuel-backend
EnvironmentFile=/opt/fuel-backend/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/fuel-backend/data

[Install]
WantedBy=multi-user.target
